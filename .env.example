# Copy this file to .env and fill in your key. Never commit .env to git.

LLM_API_KEY=put-your-key-here

# Leave LLM_BASE_URL empty for OpenAI.
# For OpenRouter: https://openrouter.ai/api/v1
# For Groq:       https://api.groq.com/openai/v1
# For Ollama (local model, no real key needed):
#   LLM_API_KEY=ollama
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen2.5:7b
#   LLM_MAX_CHARS=10000
LLM_BASE_URL=

LLM_MODEL=gpt-4o-mini

# --- Voice (Whisper) ---
# local = runs on your computer, free, no key.
# api   = uses the provider above (faster). Then also set the model name:
#         OpenAI: whisper-1      Groq: whisper-large-v3
WHISPER_MODE=local
WHISPER_MODEL=small
WHISPER_API_MODEL=whisper-1

# --- Database (started with: docker compose up -d) ---
DATABASE_URL=postgresql+psycopg://explainly:explainly@localhost:5433/explainly
